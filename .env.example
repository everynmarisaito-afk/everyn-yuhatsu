# このファイルを .env.local にコピーして値を入れてください（.env.local は GitHub に上がりません）
# Vercel では Settings → Environment Variables に同じ名前で登録します。
# どれも NEXT_PUBLIC_ を付けないこと（付けるとブラウザに漏れます）。

# 会員システムの Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# JOCAR（ジョーカー）API。3つとも空のあいだはサンプルデータで動きます。
JOCAR_API_KEY=
JOCAR_HAN_CD=
JOCAR_SEC_KEY=

# Vercel の定期実行（毎朝の同期）を本人確認する合言葉。32文字以上のランダムな文字列
# 作り方の例： node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# 空のままでOK。独自ドメインなど、開いているURLと別のURLからも使う場合だけ設定（末尾の / は不要）
APP_ORIGIN=
